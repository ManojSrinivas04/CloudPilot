# FinOps AI - Environment Configuration Example
# Copy this file to .env and configure values for your environment.

# Local PostgreSQL development credentials. Replace this placeholder locally.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg2://postgres:${POSTGRES_PASSWORD}@localhost:5432/finops_ai

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
